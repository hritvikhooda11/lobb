    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lobbapp.lobb"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://lobb.expo.app/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lobb uses the camera to scan barcodes, photograph items you list, check seals, and scan handoff QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D3CF0",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0D0A14",
    "owner": "hritvik11",
    "extra": {
      "eas": {
        "projectId": "f490bc55-e634-4f8a-b35a-740375499dff"
      }
