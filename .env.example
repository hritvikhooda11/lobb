# Copy to .env and fill in (see SUPABASE_SETUP.md). .env is git-ignored.
# Safe to ship in the app (publishable):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Server only. NEVER prefix these with EXPO_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Real store prices (server only). UPCitemdb works without a key (free trial, 100 lookups/day);
# a key raises the limit. Kroger (free at developer.kroger.com) adds today's QFC shelf price.
UPCITEMDB_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_ZIP=98105

# Stripe (payments). Test keys while testing; live keys at launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Shared secret for the scheduled /api/pay/settle call
LOBB_CRON_SECRET=
