# Copy to .env and fill in (see SUPABASE_SETUP.md). .env is git-ignored.
# Safe to ship in the app (publishable):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Server only. NEVER prefix these with EXPO_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Dev/demo sign-in without email (/api/dev-code). Never set in production.
LOBB_DEV_LOGIN=
# Demo mode: "Continue" signs in without email (dev builds only; needs LOBB_DEV_LOGIN=1)
EXPO_PUBLIC_DEMO_LOGIN=
